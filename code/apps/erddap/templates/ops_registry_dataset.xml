<dataset type="EDDTableFromJsonlCSVFiles" datasetID="envds_system_registry" active="true">
    <reloadEveryNMinutes>10</reloadEveryNMinutes>
    <updateEveryNMillis>10000</updateEveryNMillis>
    
    <fileDir>/erddapData/registry/system/</fileDir>
    <fileNameRegex>.*\.jsonl</fileNameRegex>
    <recursive>true</recursive>
    <pathRegex>.*</pathRegex>
    <metadataFrom>last</metadataFrom>
    <sortedColumnSourceName>time</sortedColumnSourceName>
    <sortFilesBySourceNames>time</sortFilesBySourceNames>
    <fileTableInMemory>false</fileTableInMemory>
    <accessibleViaFiles>true</accessibleViaFiles>

    <addAttributes>
        <att name="cdm_data_type">TimeSeries</att>
        <att name="cdm_timeseries_variables">time, kind, namespace, name</att>
        <att name="Conventions">COARDS, CF-1.6, ACDD-1.3</att>
        <att name="summary">This is a summary of the dataset for ERDDAP.</att>
        <att name="institution">NOAA PMEL</att>
        <att name="infoUrl">https://www.pmel.noaa.gov/</att>
        <att name="envds_stream_type">registry</att>
        <att name="title">ENVDS System Definitions Registry</att>
    </addAttributes>

    <dataVariable><sourceName>kind</sourceName><destinationName>kind</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>namespace</sourceName><destinationName>namespace</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>name</sourceName><destinationName>name</destinationName><dataType>String</dataType></dataVariable>

    <dataVariable>
        <sourceName>time</sourceName>
        <destinationName>time</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="units">seconds since 1970-01-01T00:00:00Z</att>
        </addAttributes>
    </dataVariable>

    <dataVariable><sourceName>valid_config_time</sourceName><destinationName>valid_config_time</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>revision</sourceName><destinationName>revision</destinationName><dataType>int</dataType></dataVariable>

    <dataVariable>
        <sourceName>payload</sourceName>
        <destinationName>payload</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="description">Stringified JSON of the full system definition</att>
        </addAttributes>
    </dataVariable>
</dataset>