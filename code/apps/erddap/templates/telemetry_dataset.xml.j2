<dataset type="EDDTableFromHttpGet" datasetID="{{ dataset_id }}" active="true">
    <reloadEveryNMinutes>1440</reloadEveryNMinutes>
    <updateEveryNMillis>-1</updateEveryNMillis>
    
    <fileDir>/erddapData/telemetry/{{ make }}/{{ model }}/{{ version }}/{{ shape_joined }}/</fileDir>
    
    <fileNameRegex>.*\.jsonl</fileNameRegex>
    <recursive>true</recursive>
    <pathRegex>.*</pathRegex>
    <metadataFrom>last</metadataFrom>
    <sortedColumnSourceName></sortedColumnSourceName>
    <sortFilesBySourceNames>make,model,format_version,serial_number,time</sortFilesBySourceNames>
    <fileTableInMemory>true</fileTableInMemory>
    <accessibleViaFiles>true</accessibleViaFiles>

    <addAttributes>
        <att name="cdm_data_type">TimeSeries</att>
        <att name="cdm_timeseries_variables">time</att>
        <att name="Conventions">COARDS, CF-1.6, ACDD-1.3</att>
        <att name="infoUrl">http://envds.local</att>
        <att name="institution">MSP</att>
        
        <att name="author">envds_sidecar</att>
        <att name="password">default_secret</att>

        <att name="httpGetRequiredVariables">author,password</att>

        <att name="httpGetDirectoryStructure">serial_number/1year/1day</att>

        <att name="envds_stream_type">telemetry</att>
        <att name="shape_hierarchy">{{ shape_joined }}</att>
    </addAttributes>

    <dataVariable><sourceName>make</sourceName><destinationName>make</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>model</sourceName><destinationName>model</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>serial_number</sourceName><destinationName>serial_number</destinationName><dataType>String</dataType></dataVariable>
    <dataVariable><sourceName>format_version</sourceName><destinationName>format_version</destinationName><dataType>String</dataType></dataVariable>

    <dataVariable>
        <sourceName>time</sourceName>
        <destinationName>time</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="units">seconds since 1970-01-01T00:00:00Z</att>
        </addAttributes>
    </dataVariable>

    {% for var in columns %}
    <dataVariable>
        <sourceName>{{ var.name }}</sourceName>
        <destinationName>{{ var.name }}</destinationName>
        <dataType>{{ 'String' if var.type in ['str', 'string', 'char'] else var.type }}</dataType>
        <addAttributes>
            <att name="ioos_category">Unknown</att>
            {% if var.units %}
            <att name="units">{{ var.units }}</att>
            {% endif %}
            <att name="long_name">{{ var.long_name | default(var.name) }}</att>
            {% if var.variable_type %}
            <att name="envds_variable_type">{{ var.variable_type }}</att>
            {% endif %}
        </addAttributes>
    </dataVariable>
    {% endfor %}
</dataset>